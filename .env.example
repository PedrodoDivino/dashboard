# Copie para .env.local e preencha.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do app (links dos e-mails). Em produção, a URL da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta (service role / secret key) — só no servidor. Usada para cadastrar usuários.
SUPABASE_SECRET_KEY=
